# Copy to .env locally. Never commit the real file.
AI_API_KEY=
# DeepSeek official API root; the app appends /chat/completions.
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
# Optional actual price per million tokens in your chosen currency.
AI_INPUT_PRICE_PER_MILLION=
AI_OUTPUT_PRICE_PER_MILLION=
AI_CURRENCY=CNY
DEMO_MODE=true
COOKIE_SECURE=false
DATA_DIR=runtime
# Required when DEMO_MODE=false; use your own strong password.
FOUNDER_PASSWORD=
